<ResourceDictionary
    x:Class="NINA.Point3d.MotorPosition.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  NINA picks the options template by <IPlugin.Name>_Options  -->
    <DataTemplate x:Key="Point3D Motor Position_Options">
        <StackPanel Orientation="Vertical">
            <Label Content="Model display options" Margin="0,5,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Content="OTA Style"/>
                <ComboBox Margin="5,0,0,0" ItemsSource="{Binding OTAStyles}" DisplayMemberPath="Key" SelectedValuePath="Value" SelectedValue="{Binding Settings.OtaStyle}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Content="Model Color"/>
                <ComboBox Margin="5,0,0,0" ItemsSource="{Binding ModelColors}" DisplayMemberPath="Key" SelectedValuePath="Value" SelectedValue="{Binding Settings.ModelColor}"/>
            </StackPanel>
            <Label Margin="0,5,0,0" Content="Below are offsets for the model in degrees, only change them if the model does not match how your telescope is pointing. Typically they should be changed in multiples of 90 and can be positive or negative."/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Content="X Offset (Dec)"/>
                <TextBox MinWidth="50" Margin="5,0,0,0" Text="{Binding Settings.XOffset}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Content="Y Offset (RA)"/>
                <TextBox MinWidth="50" Margin="5,0,0,0" Text="{Binding Settings.YOffset}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Content="Z Offset"/>
                <TextBox MinWidth="50" Margin="5,0,0,0" Text="{Binding Settings.ZOffset}"/>
            </StackPanel>

            <Separator Margin="0,10,0,5"/>
            <Label Content="OnStepX TCP connection, applied on the next Connect"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Content="Host"/>
                <TextBox MinWidth="140" Margin="5,0,0,0" Text="{Binding Settings.Host}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Content="Port"/>
                <TextBox MinWidth="60" Margin="5,0,0,0" Text="{Binding Settings.Port}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Content="Poll Interval (s)"/>
                <TextBox MinWidth="40" Margin="5,0,0,0" Text="{Binding Settings.PollIntervalSeconds}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Content="Auto Reconnect"/>
                <CheckBox Margin="5,4,0,0" IsChecked="{Binding Settings.AutoReconnect}"/>
            </StackPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>

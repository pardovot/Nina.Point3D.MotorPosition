<ResourceDictionary
    x:Class="NINA.Point3d.MotorPosition.DataTemplate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:NINA.Point3D.Controls">

    <!--  NINA picks a dockable's template by the fully qualified VM class name plus _Dockable  -->
    <DataTemplate x:Key="NINA.Point3d.MotorPosition.MotorPositionVM_Dockable">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,2,4,2">
                <Button Content="Connect" Command="{Binding ConnectCommand}" Margin="0,0,4,0" Padding="10,3"/>
                <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Margin="0,0,8,0" Padding="10,3"/>
                <TextBlock Text="{Binding ConnectionState}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ToggleButton Content="Follow Point3D view" IsChecked="{Binding FollowPoint3DView}">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="OverridesDefaultStyle" Value="True"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border" Background="#FFDDDDDD" BorderBrush="#FF888888"
                                                BorderThickness="1" Padding="8,3" CornerRadius="2">
                                            <TextBlock x:Name="label"
                                                       Text="{TemplateBinding Content}"
                                                       Foreground="#FF222222" FontSize="11"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FFBBBBBB"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FF4CAF50"/>
                                                <Setter TargetName="label" Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsChecked" Value="True"/>
                                                    <Condition Property="IsMouseOver" Value="True"/>
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="border" Property="Background" Value="#FF45A049"/>
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
            </StackPanel>
            <controls:HelixViewport3D IsEnabled="{Binding ModelOn}">
                <controls:HelixViewport3D.Style>
                    <Style TargetType="controls:HelixViewport3D">
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="True">
                                <Setter Property="Opacity" Value="1.0" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </controls:HelixViewport3D.Style>
            </controls:HelixViewport3D>
        </DockPanel>
    </DataTemplate>

</ResourceDictionary>
